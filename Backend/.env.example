# ─── Mode ───────────────────────────────────────────────────────────────
# Set to "false" to use real Oracle Fusion AI Agent Studio
MOCK_MODE=true

# ─── Oracle Fusion Cloud ────────────────────────────────────────────────
# Your Fusion Cloud hostname (e.g., ehjy-test.fa.ocs.oraclecloud.com)
FUSION_HOST=your-fusion-host.fa.ocs.oraclecloud.com

# OAuth2 credentials from OCI IAM / Identity Domain confidential app
OAUTH_TOKEN_URL=https://your-identity-domain.identity.oraclecloud.com/oauth2/v1/token
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_SCOPE=urn:opc:resource:fusion:your-pod:fusion-ai/

# ─── Oracle AI Agent Studio ────────────────────────────────────────────
# Agent Team Code from AI Agent Studio (found in team settings)
AGENT_TEAM_CODE=YOUR_AGENT_TEAM_CODE
# Published version number of the agent team
AGENT_TEAM_VERSION=1

# ─── Logging Configuration ─────────────────────────────────────────────
# Enable database logging of API requests and application events
ENABLE_DB_LOGGING=true
# Enable file logging with rotation
ENABLE_FILE_LOGGING=true
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Maximum size for request/response body logging (bytes)
LOG_MAX_BODY_SIZE=10000
